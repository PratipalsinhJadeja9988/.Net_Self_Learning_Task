@model List<Student>

@{
    ViewData["Title"] = "Student list";
}

<header class="page-head">
    <h1>Student list</h1>
    <p class="lead">Search by name, email or course, filter by semester, and click a column heading to sort.</p>
</header>

@if (Model.Count == 0)
{
    <div class="card empty">
        <h2>No students yet</h2>
        <p class="muted">Registered students will appear here.</p>
        <div class="actions">
            <a class="btn btn-primary" asp-action="Create">Register the first student</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="toolbar">
            <input type="search" id="search-box" placeholder="Search students" aria-label="Search students" />
            <select id="semester-filter" aria-label="Filter by semester">
                <option value="">All semesters</option>
                @for (int i = 1; i <= 8; i++)
                {
                    <option value="@i">Semester @i</option>
                }
            </select>
            <span class="muted" id="result-count"></span>
            <a class="btn btn-primary push-right" asp-action="Create">Register student</a>
        </div>

        <div class="table-wrap">
            <table id="student-table">
                <thead>
                    <tr>
                        <th><button type="button" class="sort" data-key="0" data-type="number">Id</button></th>
                        <th><button type="button" class="sort" data-key="1" data-type="text">Name</button></th>
                        <th><button type="button" class="sort" data-key="2" data-type="text">Course</button></th>
                        <th><button type="button" class="sort" data-key="3" data-type="number">Semester</button></th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-semester="@item.Semester">
                            <td>@item.Id</td>
                            <td>
                                <strong>@item.Name</strong><br />
                                <span class="muted small">@item.Email</span>
                            </td>
                            <td>@item.Course</td>
                            <td><span class="badge">Semester @item.Semester</span></td>
                            <td><a asp-action="Details" asp-route-id="@item.Id">View details</a></td>
                        </tr>
                    }
                    <tr id="no-match" hidden>
                        <td colspan="5" class="muted">No student matches your search.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/student-list.js"></script>
}
